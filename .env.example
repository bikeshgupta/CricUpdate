# Firebase web app config (Project settings → Your apps → SDK setup and config).
# Copy this file to `.env` and fill in your project's values. When these are
# present the app uses real Google sign-in + Firestore; otherwise it runs the
# in-memory mock so local development still works.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
