rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Matches are publicly readable (so anyone with the share link can watch
    // live), but only the signed-in owner may create or modify them.
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Optional per-user profile docs.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Claimable player stat cards, keyed by normalized player name. A profile
    // only exists once claimed, so create succeeding means "first to claim".
    match /playerProfiles/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.claimedByUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.claimedByUid == request.auth.uid;
      allow delete: if false;
    }

    // Reserves a unique handle for a claimed player profile.
    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
