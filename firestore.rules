rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Matches are publicly readable (so anyone with the share link can watch
    // live), but only the signed-in owner may create or modify them.
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Reusable named player pools ("squads"), e.g. a recurring Friday game.
    // Same trust model as matches: public read, owner-only write.
    match /squads/{squadId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Tournaments are followable like matches (public read); owner manages them.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // RSVPs against a 'planning' match — anyone with the share link can RSVP
    // ("I'm in"), and RSVPs are never edited or deleted once sent.
    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Optional per-user profile docs.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Claimable player stat cards, keyed by normalized player name. A profile
    // only exists once claimed, so create succeeding means "first to claim".
    match /playerProfiles/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.claimedByUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.claimedByUid == request.auth.uid;
      allow delete: if false;
    }

    // Reserves a unique handle for a claimed player profile.
    match /handles/{handle} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
